# Backend
APP_NAME=IncidentLens AI
APP_VERSION=0.1.0
DATABASE_URL=postgresql://incidentlens:incidentlens@localhost:5432/incidentlens
# Optional. If unset, the backend derives postgresql+asyncpg from DATABASE_URL.
DATABASE_URL_ASYNC=
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker Compose host ports
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=5173

# Frontend
VITE_API_URL=http://localhost:8000
VITE_DEMO_MODE=false
